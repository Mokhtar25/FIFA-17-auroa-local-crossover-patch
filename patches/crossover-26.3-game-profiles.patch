 /***********************************************************************
+ *           CrossOver-FIFA game profiles  (CX_GAME_PROFILES)
+ *
+ * The FIFA workarounds in this ntdll (CX_DR_TRAP, CX_TOPDOWN_LIMIT,
+ * CX_FIFA16_DSTFIX) used to be bottle-wide environment variables.  The
+ * community launchers start several FIFA games out of one bottle, so a game
+ * got whatever its launcher's bottle was set up for: FIFA 15 in an Aurora17
+ * bottle ran with FIFA 17's CX_DR_TRAP=2 and without CX_TOPDOWN_LIMIT, and
+ * died with 0x80000004.
+ *
+ * So each process picks its settings by the file name of its main exe, once,
+ * in start_main_thread before any guest code runs.  Per setting, the first of
+ * these that says anything wins:
+ *
+ *   1. HKCU\Software\Wine\AppDefaults\<exe>\CrossOver-FIFA, REG_SZ "DrTrap",
+ *      "TopdownLimit", "Fifa16DstFix" (the env var syntax; "off" also turns
+ *      Fifa16DstFix off)
+ *   2. the same key's "Profile" = fifa15|fifa16|fifa17|fifa21|none, for a
+ *      renamed exe; "none" turns the table off for that exe
+ *   3. the built-in table below, exe name compared case-insensitively
+ *   4. the bare environment variable, as before -- what every process the
+ *      table does not name (launchers, WebView2, .NET helpers) keeps getting
+ *   5. off
+ *
+ * A profile, once picked, sets all three settings, including the ones it
+ * turns off: that is the point, the bottle's other game's values must not
+ * leak in.  CX_GAME_PROFILES=0 ignores layers 1-3 and leaves exactly the old
+ * behaviour.  WINEDEBUG=+cxprofile logs one CXPROFILE line per process.
+ */
+
+struct cx_settings
+{
+    int       dr_trap;      /* CX_DR_TRAP: 0 off, 1 probe, 2 deliver, 3 emulate */
+    ULONG_PTR topdown;      /* CX_TOPDOWN_LIMIT: 0 off */
+    int       dstfix;       /* CX_FIFA16_DSTFIX: 0 off, 1 on */
+    ULONG_PTR dstfix_val;   /* its replacement value, 0 = ~target (auto) */
+};
+
+/* FIFA 15's CX_DR_TRAP.  Its own bottle never set one; this is the one place
+ * to change if it turns out to want FIFA 17's 2. */
+#define CX_FIFA15_DR_TRAP 0
+
+static const struct cx_game_profile
+{
+    const char        *name;
+    struct cx_settings settings;
+} cx_game_profiles[] =
+{
+    { "fifa15", { CX_FIFA15_DR_TRAP, 0x1ffffffff, 0, 0 } },
+    { "fifa16", { 3,                 0,           1, 0 } },
+    { "fifa17", { 2,                 0,           0, 0 } },
+    { "fifa21", { 2,                 0,           0, 0 } },
+};
+
+static const struct
+{
+    const char *exe;
+    const char *profile;
+} cx_game_exes[] =
+{
+    { "fifa15.exe",       "fifa15" },
+    { "fifa16.exe",       "fifa16" },
+    { "fifa17.exe",       "fifa17" },
+    { "_fifa17.exe",      "fifa17" },
+    { "fifa21.exe",       "fifa21" },
+    { "fifa21_trial.exe", "fifa21" },
+};
+
+static struct cx_settings cx_profile;   /* valid once cx_profile_ready is set */
+static int cx_profile_ready;
+
+static int cx_parse_dr_trap( const char *val )
+{
+    int mode = val ? val[0] - '0' : 0;
+    return (mode < 0 || mode > 3) ? 0 : mode;
+}
+
+static ULONG_PTR cx_parse_topdown( const char *val )
+{
+    return val ? strtoull( val, NULL, 0 ) : 0;
+}
+
+static void cx_parse_dstfix( const char *val, struct cx_settings *s )
+{
+    s->dstfix = val != NULL;
+    s->dstfix_val = val ? strtoull( val, NULL, 16 ) : 0;
+}
+
+static void cx_env_settings( struct cx_settings *s )
+{
+    s->dr_trap = cx_parse_dr_trap( getenv( "CX_DR_TRAP" ));
+    s->topdown = cx_parse_topdown( getenv( "CX_TOPDOWN_LIMIT" ));
+    cx_parse_dstfix( getenv( "CX_FIFA16_DSTFIX" ), s );
+}
+
+/* The bare variables, parsed once: the getters' answer until the profile is
+ * resolved.  Kept apart from cx_profile so that nothing read this early can
+ * stand in for the profile.  cx_env_init runs first thing in
+ * start_main_thread; anything earlier parses them on its first call.  Two
+ * threads racing here write the same values. */
+static struct cx_settings cx_env;
+static int cx_env_ready;
+
+static const struct cx_settings *cx_env_get(void)
+{
+    if (!__atomic_load_n( &cx_env_ready, __ATOMIC_ACQUIRE ))
+    {
+        struct cx_settings s;
+
+        cx_env_settings( &s );
+        cx_env = s;
+        __atomic_store_n( &cx_env_ready, 1, __ATOMIC_RELEASE );
+    }
+    return &cx_env;
+}
+
+static void cx_env_init(void)
+{
+    cx_env_get();
+}
+
+static const struct cx_game_profile *cx_profile_by_name( const char *name )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(cx_game_profiles); i++)
+        if (!strcasecmp( name, cx_game_profiles[i].name )) return &cx_game_profiles[i];
+    return NULL;
+}
+
+static const struct cx_game_profile *cx_profile_by_exe( const WCHAR *exe )
+{
+    WCHAR nameW[32];
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(cx_game_exes); i++)
+    {
+        ascii_to_unicode( nameW, cx_game_exes[i].exe, strlen( cx_game_exes[i].exe ) + 1 );
+        if (!ntdll_wcsicmp( exe, nameW )) return cx_profile_by_name( cx_game_exes[i].profile );
+    }
+    return NULL;
+}
+
+/* HKCU\Software\Wine\AppDefaults\<exe>\CrossOver-FIFA, or 0 */
+static HANDLE cx_open_app_key( const WCHAR *exe )
+{
+    static const char subkey[] = "\\CrossOver-FIFA";
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW;
+    HANDLE root, key = 0;
+    ULONG len = wcslen( exe );
+
+    if (open_hkcu_key( "Software\\Wine\\AppDefaults", &root )) return 0;
+    nameW.Buffer = malloc( (len + sizeof(subkey)) * sizeof(WCHAR) );
+    if (nameW.Buffer)
+    {
+        memcpy( nameW.Buffer, exe, len * sizeof(WCHAR) );
+        ascii_to_unicode( nameW.Buffer + len, subkey, sizeof(subkey) );
+        nameW.Length = (len + sizeof(subkey) - 1) * sizeof(WCHAR);
+        nameW.MaximumLength = nameW.Length + sizeof(WCHAR);
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, root, NULL );
+        if (NtOpenKey( &key, KEY_QUERY_VALUE, &attr )) key = 0;
+        free( nameW.Buffer );
+    }
+    NtClose( root );
+    return key;
+}
+
+/* A REG_SZ value as ASCII, blanks trimmed.  FALSE if missing, empty or not
+ * text. */
+static BOOL cx_reg_string( HANDLE key, const char *name, char *buf, size_t size )
+{
+    union
+    {
+        KEY_VALUE_PARTIAL_INFORMATION info;
+        BYTE bytes[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data ) + 64 * sizeof(WCHAR)];
+    } data;
+    const WCHAR *str;
+    WCHAR nameW[32];
+    UNICODE_STRING nameU;
+    DWORD count, len, i, n = 0;
+
+    if (!key) return FALSE;
+    ascii_to_unicode( nameW, name, strlen( name ) + 1 );
+    init_unicode_string( &nameU, nameW );
+    if (NtQueryValueKey( key, &nameU, KeyValuePartialInformation, &data, sizeof(data), &count ))
+        return FALSE;
+    if (data.info.Type != REG_SZ && data.info.Type != REG_EXPAND_SZ)
+    {
+        WARN_(cxprofile)( "%s is not REG_SZ, ignored\n", name );
+        return FALSE;
+    }
+    str = (const WCHAR *)data.info.Data;
+    len = data.info.DataLength / sizeof(WCHAR);
+    for (i = 0; i < len && str[i]; i++)
+    {
+        if (str[i] == ' ' || str[i] == '\t') continue;
+        if (str[i] >= 0x80 || n + 1 >= size) return FALSE;
+        buf[n++] = str[i];
+    }
+    buf[n] = 0;
+    return n > 0;  /* an empty value says nothing: as if it were not there */
+}
