+/***********************************************************************
+ *           virtual_alias_user_shared_data
+ *
+ * The second view of the user shared data that CX_DR_TRAP=3 reads through,
+ * for a process whose game profile (loader.c) resolves to mode 3 although
+ * the bottle-wide variable did not, so virtual_map_user_shared_data did not
+ * set one up.  Runs before any guest code; a no-op if the view exists.
+ */
+void virtual_alias_user_shared_data(void)
+{
+    UNICODE_STRING name_str = RTL_CONSTANT_STRING( shared_data_nameW );
+    OBJECT_ATTRIBUTES attr = { sizeof(attr), 0, &name_str };
+    HANDLE section;
+    int fd, needs_close;
+    void *alias;
+
+    if ((ULONG_PTR)user_shared_data != 0x7ffe0000) return;
+    if (NtOpenSection( &section, SECTION_ALL_ACCESS, &attr ))
+    {
+        ERR( "no second view of the USD: cannot open its section\n" );
+        return;
+    }
+    if (!server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL ))
+    {
+        if ((alias = mmap( NULL, page_size, PROT_READ, MAP_SHARED, fd, 0 )) != MAP_FAILED)
+            user_shared_data = alias;
+        else
+            ERR( "no second view of the USD: mmap failed\n" );
+        if (needs_close) close( fd );
+    }
+    else ERR( "no second view of the USD: no unix fd\n" );
     NtClose( section );
