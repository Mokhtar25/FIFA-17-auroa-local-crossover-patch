+/***********************************************************************
+ *           cx_profile_init
+ *
+ * Called once, from start_main_thread, as soon as the main exe's name is
+ * known (init_startup_info) and before any guest code runs.
+ */
+void cx_profile_init(void)
+{
+    const char *val = getenv( "CX_GAME_PROFILES" );
+    BOOL enabled = !(val && val[0] == '0');
+    const struct cx_game_profile *game = NULL;
+    const char *source = "none", *profile = "none";
+    const WCHAR *exe = main_wargv[0], *p;
+    struct cx_settings s;
+    char buf[64], dstfix[24], topdown[24], exe_a[256];
+    HANDLE key = 0;
+    int len;
+
+    if ((p = wcsrchr( exe, '\\' ))) exe = p + 1;
+    if ((p = wcsrchr( exe, '/' ))) exe = p + 1;
+
+    /* layer 4: the bottle-wide variables, exactly as before */
+    s = *cx_env_get();
+    if (getenv( "CX_DR_TRAP" ) || getenv( "CX_TOPDOWN_LIMIT" ) || getenv( "CX_FIFA16_DSTFIX" ))
+        source = "env";
+
+    if (enabled)
+    {
+        /* layer 3: the table */
+        if ((game = cx_profile_by_exe( exe ))) source = "table";
+
+        /* layer 2: an AppDefaults profile, or "none" */
+        key = cx_open_app_key( exe );
+        if (cx_reg_string( key, "Profile", buf, sizeof(buf) ))
+        {
+            const struct cx_game_profile *named = cx_profile_by_name( buf );
+
+            if (named || !strcasecmp( buf, "none" ))
+            {
+                game = named;
+                source = "appdefaults";
+            }
+            else WARN_(cxprofile)( "unknown Profile %s for %s, ignored\n", debugstr_a(buf), debugstr_w(exe) );
+        }
+        if (game)
+        {
+            s = game->settings;
+            profile = game->name;
+        }
+
+        /* layer 1: one setting at a time */
+        if (cx_reg_string( key, "DrTrap", buf, sizeof(buf) ))
+        {
+            s.dr_trap = cx_parse_dr_trap( buf );
+            source = "appdefaults";
+        }
+        if (cx_reg_string( key, "TopdownLimit", buf, sizeof(buf) ))
+        {
+            s.topdown = cx_parse_topdown( buf );
+            source = "appdefaults";
+        }
+        if (cx_reg_string( key, "Fifa16DstFix", buf, sizeof(buf) ))
+        {
+            cx_parse_dstfix( strcasecmp( buf, "off" ) ? buf : NULL, &s );
+            source = "appdefaults";
+        }
+        if (key) NtClose( key );
+    }
+
+    cx_profile = s;
+    __atomic_store_n( &cx_profile_ready, 1, __ATOMIC_RELEASE );
+
+    /* Mode 3 reads KUSER_SHARED_DATA through a second view, which
+     * virtual_map_user_shared_data only set up if the bottle-wide variable
+     * said 3; a profile can say 3 for a process whose bottle does not. */
+    if (s.dr_trap == 3) virtual_alias_user_shared_data();
+
+    len = ntdll_wcstoumbs( exe, wcslen( exe ), exe_a, sizeof(exe_a) - 1, FALSE );
+    exe_a[len > 0 ? len : 0] = 0;
+    if (!s.topdown) strcpy( topdown, "0" );
+    else snprintf( topdown, sizeof(topdown), "0x%lx", (unsigned long)s.topdown );
+    if (!s.dstfix) strcpy( dstfix, "off" );
+    else if (!s.dstfix_val) strcpy( dstfix, "auto" );
+    else snprintf( dstfix, sizeof(dstfix), "0x%lx", (unsigned long)s.dstfix_val );
+    TRACE_(cxprofile)( "CXPROFILE exe=%s profile=%s source=%s dr_trap=%d topdown=%s dstfix=%s "
+                       "image_size=0x%x checksum=0x%08x%s\n",
+                       exe_a, profile, source, s.dr_trap, topdown, dstfix,
+                       (int)main_image_info.ImageFileSize, (int)main_image_info.CheckSum,
+                       enabled ? "" : " CX_GAME_PROFILES=0" );
+}
+
+static inline BOOL cx_profile_resolved(void)
+{
+    return __atomic_load_n( &cx_profile_ready, __ATOMIC_ACQUIRE );
+}
+
+/* The getters.  Before cx_profile_init has run they answer from the bare
+ * variables, as the old build did, out of cx_env (parsed once, no getenv per
+ * call: save_context calls cx_dr_trap on every signal).  That answer is not
+ * the profile's, so a signal taken that early cannot pin the process to the
+ * bottle's value instead of its own. */
+int cx_dr_trap(void)
+{
+    if (cx_profile_resolved()) return cx_profile.dr_trap;
+    return cx_env_get()->dr_trap;
+}
+
+ULONG_PTR cx_topdown_limit(void)
+{
+    if (cx_profile_resolved()) return cx_profile.topdown;
+    return cx_env_get()->topdown;
+}
+
+BOOL cx_fifa16_dstfix( ULONG_PTR *value )
+{
+    const struct cx_settings *s = cx_profile_resolved() ? &cx_profile : cx_env_get();
+
+    *value = s->dstfix_val;
+    return s->dstfix;
+}
+
+/* PF_PAE_ENABLED lives in KUSER_SHARED_DATA, which the process that boots
+ * the session fills in once for every process in it, so it cannot follow a
+ * per-process profile.  CX_PF_PAE=1 turns it on for the session; a bare
+ * CX_DR_TRAP=3 still does too.  64-bit Windows always reports it. */
+BOOL cx_pf_pae(void)
+{
+    const char *val = getenv( "CX_PF_PAE" );
+
+    if (val && val[0] == '1') return TRUE;
+    return cx_env_get()->dr_trap == 3;
+}
