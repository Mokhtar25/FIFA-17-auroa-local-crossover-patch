+/* CX_WIN_SEGS: macOS runs 64-bit user code with cs=0x2b/ss=0x23, while Windows always
+ * has cs=0x33/ss=0x2b.  Guests that validate CONTEXT.SegCs see the difference, so this
+ * option reports Windows selectors in the contexts handed to the guest. */
+static int win_segs_mode(void)
+{
+    static int mode = -1;
+
+    if (mode == -1)
+    {
+        const char *value = getenv( "CX_WIN_SEGS" );
+        mode = (value && value[0] && value[0] != '0');
+    }
+    return mode;
 }
 
+static void apply_win_segs( CONTEXT *context )
+{
+    if (!win_segs_mode()) return;
+    if (context->SegCs != cs64_sel) return;  /* leave 32-bit contexts alone */
+    context->SegCs = 0x33;
+    context->SegSs = 0x2b;
+    context->SegDs = 0x2b;
+    context->SegEs = 0x2b;
+    context->SegGs = 0x2b;
+    context->SegFs = 0x53;
+}
 
 static inline void set_sigcontext( const CONTEXT *context, ucontext_t *sigcontext )
 {
