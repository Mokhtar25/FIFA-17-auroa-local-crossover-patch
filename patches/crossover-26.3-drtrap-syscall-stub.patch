CX_DR_TRAP=3: system calls stop faulting while a read watchpoint is armed on
KUSER_SHARED_DATA.

Mode 3 emulates a read+write watchpoint by taking every access away from the
watched page. Runtime protection systems keep such watchpoints armed on
KUSER_SHARED_DATA+0x270 for the whole session, and every syscall stub in
Wine's ntdll reads that page (testb $1,0x7ffe0308, the Windows form). So every
system call from every thread took a fault, and under Rosetta a fault costs
about 16 us whatever the handler does (a plain x86_64 SIGSEGV round trip
measures the same). FIFA 16 made ~70,000 of them a second and stuttered.

The first time a stub inside ntdll faults on that read, its displacement is
pointed at a copy of SystemCall at 0x7ffe1008, on the page Wine already keeps
the dispatcher pointer on, which no watchpoint covers. One byte changes; the
instruction's length and result do not. Stubs outside ntdll are never
touched, nor is a code page that carries a watchpoint of its own.

tests/drbp/kuser_perf.exe, armed vs unarmed, FIFA16-dev bottle:
  QueryPerformanceCounter   17378 ns -> 72 ns   (unarmed 61 ns)
  GetSystemTimeAsFileTime   17045 ns -> 78 ns   (unarmed 78 ns)
In the game: ~70,000 faults/s -> 1,000-4,000/s. GetTickCount and direct reads
of the time fields still fault (they read the page itself); the game does ~300/s.

Applies after crossover-26.3-fifa16-dst-complement.patch. Nothing changes
unless a bottle sets CX_DR_TRAP=3.
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2435,6 +2435,60 @@
         (context->EFlags & 0x10000) && (t = xbp_thread_slot( tid, TRUE )) >= 0)
         xbp_thread[t].skip_addr = context->Rip;
     xbp_release();
+}
+
+/* Every syscall stub in Wine's ntdll has the Windows form
+ *     4c 8b d1         movq %rcx,%r10
+ *     b8 <id>          movl $id,%eax
+ *     f6 04 25 08 03 fe 7f 01   testb $1,0x7ffe0308   (SystemCall)
+ * so while a read watchpoint keeps the user shared data page inaccessible,
+ * every system call takes a fault, and under Rosetta each costs ~16us: tens
+ * of thousands a second in a game, which is a stutter.  The first time a stub
+ * inside ntdll faults there, its testb is pointed at a copy of SystemCall at
+ * 0x7ffe1008, beside the dispatcher pointer on Wine's own page, which no
+ * watchpoint ever covers.  One byte of the address changes; the length and
+ * the result do not.  Stubs outside ntdll are never touched. */
+static ULONG_PTR xbp_ntdll_start, xbp_ntdll_end;
+
+static BOOL xbp_stub_redirect( ULONG_PTR rip )
+{
+    static const BYTE testb[8] = { 0xf6, 0x04, 0x25, 0x08, 0x03, 0xfe, 0x7f, 0x01 };
+    BYTE *p = (BYTE *)rip;
+    ULONG_PTR page;
+
+    if (!xbp_ntdll_start)
+    {
+        /* images are 64k aligned, and everything from the base up to any
+         * code address inside the image is mapped */
+        ULONG_PTR b = (ULONG_PTR)pKiUserExceptionDispatcher & ~(ULONG_PTR)0xffff;
+        const IMAGE_DOS_HEADER *dos;
+        const IMAGE_NT_HEADERS *nt;
+        int i;
+
+        if (!b) return FALSE;
+        for (i = 0; i < 256; i++, b -= 0x10000)
+        {
+            dos = (const IMAGE_DOS_HEADER *)b;
+            if (dos->e_magic != IMAGE_DOS_SIGNATURE) continue;
+            nt = (const IMAGE_NT_HEADERS *)(b + dos->e_lfanew);
+            if (nt->Signature != IMAGE_NT_SIGNATURE) continue;
+            xbp_ntdll_end = b + nt->OptionalHeader.SizeOfImage;
+            xbp_ntdll_start = b;
+            break;
+        }
+        if (!xbp_ntdll_start) return FALSE;
+    }
+    if (rip < xbp_ntdll_start + 8 || rip + 8 > xbp_ntdll_end) return FALSE;
+    if (memcmp( p, testb, sizeof(testb) )) return FALSE;
+    if (p[-8] != 0x4c || p[-7] != 0x8b || p[-6] != 0xd1 || p[-5] != 0xb8) return FALSE;
+    page = (ULONG_PTR)(p + 4) & ~(ULONG_PTR)0xfff;
+    if (xbp_find_page( page ) >= 0) return FALSE;   /* a watched code page: leave it be */
+
+    *(volatile BYTE *)0x7ffe1008 = ((const BYTE *)user_shared_data)[0x308];
+    if (mprotect( (void *)page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC )) return FALSE;
+    p[4] = 0x10;   /* 0x7ffe0308 -> 0x7ffe1008 */
+    mprotect( (void *)page, 0x1000, PROT_READ | PROT_EXEC );
+    return TRUE;
 }
 
 /* Called from segv_handler for a page fault.
@@ -2492,6 +2546,8 @@
                 unsigned long long val = 0;
 
                 memcpy( &val, (const unsigned char *)user_shared_data + (ld.ea & 0xfff), ld.width );
+                if (guest && (ld.ea & 0xfff) == 0x308 && xbp_stub_redirect( rip ))
+                    WARN_(seh)( "syscall stub at %#lx now reads SystemCall at 0x7ffe1008\n", rip );
                 xbp_apply_load( ucontext, &ld, val );
                 RIP_sig(ucontext) = rip + ld.len;
                 if (t >= 0 && xbp_thread[t].skip_addr == rip)   /* RF: run it once, no trap */
