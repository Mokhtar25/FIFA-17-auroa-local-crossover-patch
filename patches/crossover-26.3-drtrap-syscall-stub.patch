-static UINT64 get_tick_count(void)
+/* whether the queue was accessed less than 3 seconds ago.  The tick count
+ * comes from ntdll rather than straight off 0x7ffe0000: while a debug-register
+ * watchpoint is emulated on that page (CX_DR_TRAP=3) every read of it faults,
+ * three per call here, on every PeekMessage and GetAsyncKeyState, and ntdll
+ * reads its own unprotected view.  32-bit tick arithmetic wraps correctly. */
+static BOOL queue_accessed_recently( const queue_shm_t *queue_shm )
 {
-    ULONG high, low;
-
-    do
-    {
-        high = atomic_load_long( &user_shared_data->TickCount.High1Time );
-        low = atomic_load_ulong( &user_shared_data->TickCount.LowPart );
-    }
-    while (high != atomic_load_long( &user_shared_data->TickCount.High2Time ));
-    /* note: we ignore TickCountMultiplier */
-    return (UINT64)high << 32 | low;
+    return (ULONG)(NtGetTickCount() - (ULONG)(queue_shm->access_time / 10000)) < 3000; /* avoid hung queue */
 }
 
