+    char buf[64], dstfix[24], topdown[24], exe_a[256], gfx_buf[16];
+    const char *gfx = NULL;
     HANDLE key = 0;
     int len;
 
@@ -2485,6 +2533,24 @@
             cx_parse_dstfix( strcasecmp( buf, "off" ) ? buf : NULL, &s );
             source = "appdefaults";
         }
+        if ((gfx = cx_graphics_backend( exe, key, gfx_buf, sizeof(gfx_buf) )))
+        {
+            const char *was = getenv( "CX_GRAPHICS_BACKEND" );
+
+            if (!was || strcasecmp( was, gfx ))
+            {
+                unsigned int i;
+
+                for (i = 0; i < ARRAY_SIZE(cx_gfx_vars); i++)
+                {
+                    const char *v = getenv( cx_gfx_vars[i].name );
+                    cx_gfx_vars[i].bottle = v ? strdup( v ) : NULL;
+                }
+                cx_gfx_changed = TRUE;
+                setenv( "CX_GRAPHICS_BACKEND", gfx, 1 );
+            }
+            else gfx = NULL;  /* already the bottle's: nothing changed */
+        }
         if (key) NtClose( key );
     }
 
@@ -2504,12 +2570,60 @@
     else if (!s.dstfix_val) strcpy( dstfix, "auto" );
     else snprintf( dstfix, sizeof(dstfix), "0x%lx", (unsigned long)s.dstfix_val );
     TRACE_(cxprofile)( "CXPROFILE exe=%s profile=%s source=%s dr_trap=%d topdown=%s dstfix=%s "
-                       "image_size=0x%x checksum=0x%08x%s\n",
+                       "image_size=0x%x checksum=0x%08x%s%s%s\n",
                        exe_a, profile, source, s.dr_trap, topdown, dstfix,
                        (int)main_image_info.ImageFileSize, (int)main_image_info.CheckSum,
+                       gfx ? " gfx=" : "", gfx ? gfx : "",
                        enabled ? "" : " CX_GAME_PROFILES=0" );
+}
+
+/* Children start with this process's unix environment (CrossOver's loader
+ * is sent environ, then the __CX_UNIX_ promotions; the fork path execs with
+ * it), so the backend set above, and the CX_ACTIVE_GRAPHICS_BACKEND that
+ * cxcompatdb.so sets from it, would follow a launcher into every game it
+ * starts.  The process itself keeps them; its children get the bottle's. */
+
+/* TRUE for an environ entry ("NAME=value") a child must not get as is. */
+BOOL cx_gfx_child_drops( const char *entry )
+{
+    unsigned int i;
+    size_t len;
+
+    if (!cx_gfx_changed) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(cx_gfx_vars); i++)
+    {
+        len = strlen( cx_gfx_vars[i].name );
+        if (!strncmp( entry, cx_gfx_vars[i].name, len ) && entry[len] == '=') return TRUE;
+    }
+    return FALSE;
 }
 
+/* The entries a child gets instead, "NAME=value", for the variables the
+ * bottle sets; returns how many (up to 2) went into entries. */
+unsigned int cx_gfx_child_entries( char entries[][64] )
+{
+    unsigned int i, n = 0;
+
+    if (!cx_gfx_changed) return 0;
+    for (i = 0; i < ARRAY_SIZE(cx_gfx_vars); i++)
+        if (cx_gfx_vars[i].bottle)
+            snprintf( entries[n++], 64, "%s=%s", cx_gfx_vars[i].name, cx_gfx_vars[i].bottle );
+    return n;
+}
+
+/* In a forked child, before it execs: the bottle's values, or none. */
+void cx_gfx_child_fixup_environ(void)
+{
+    unsigned int i;
+
+    if (!cx_gfx_changed) return;
+    for (i = 0; i < ARRAY_SIZE(cx_gfx_vars); i++)
+    {
+        if (cx_gfx_vars[i].bottle) setenv( cx_gfx_vars[i].name, cx_gfx_vars[i].bottle, 1 );
+        else unsetenv( cx_gfx_vars[i].name );
+    }
+}
+
 static inline BOOL cx_profile_resolved(void)
 {
     return __atomic_load_n( &cx_profile_ready, __ATOMIC_ACQUIRE );
