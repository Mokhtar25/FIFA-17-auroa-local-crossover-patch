+            {
+                key_id_data.size = id_size;
+                pgnutls_pkcs12_bag_set_key_id( bag, ret, &key_id_data );
+            }
+        }
+        pgnutls_x509_crt_deinit( crt );
+        if (ret < 0) goto done;
+
+        if ((ret = pgnutls_pkcs12_bag_encrypt( bag, pwd, GNUTLS_PKCS_USE_PKCS12_3DES )) < 0) goto done;
+        if ((ret = pgnutls_pkcs12_set_bag( p12, bag )) < 0) goto done;
+        pgnutls_pkcs12_bag_deinit( bag );
+        bag = NULL;
+    }
+
+    if (params->key && params->key_size)
+    {
+        gnutls_datum_t pkcs8 = {0};
+        size_t pkcs8_size = 0;
+
+        if ((ret = privkey_from_ms_blob( params->key, params->key_size, &key )) < 0) goto done;
+
+        pgnutls_x509_privkey_export_pkcs8( key, GNUTLS_X509_FMT_DER, pwd,
+                                           GNUTLS_PKCS_USE_PKCS12_3DES, NULL, &pkcs8_size );
+        if (!pkcs8_size) goto done;
+        if (!(pkcs8.data = malloc( pkcs8_size ))) { status = STATUS_NO_MEMORY; goto done; }
+        pkcs8.size = pkcs8_size;
+        if ((ret = pgnutls_x509_privkey_export_pkcs8( key, GNUTLS_X509_FMT_DER, pwd,
+                                                      GNUTLS_PKCS_USE_PKCS12_3DES,
+                                                      pkcs8.data, &pkcs8_size )) < 0)
+        {
+            free( pkcs8.data );
+            goto done;
+        }
+        pkcs8.size = pkcs8_size;
+
+        if ((ret = pgnutls_pkcs12_bag_init( &bag )) < 0) { free( pkcs8.data ); goto done; }
+        ret = pgnutls_pkcs12_bag_set_data( bag, GNUTLS_BAG_PKCS8_ENCRYPTED_KEY, &pkcs8 );
+        free( pkcs8.data );
+        if (ret < 0) goto done;
+        if (key_id_data.size) pgnutls_pkcs12_bag_set_key_id( bag, ret, &key_id_data );
+        if ((ret = pgnutls_pkcs12_set_bag( p12, bag )) < 0) goto done;
