+        gnutls_x509_crt_t crt;
+        gnutls_datum_t der;
+        DWORD der_size;
+
+        if (ptr + sizeof(DWORD) > end) goto done;
+        der_size = *(const DWORD *)ptr;
+        ptr += sizeof(DWORD);
+        if (ptr + der_size > end) goto done;
+
+        der.data = (unsigned char *)ptr;
+        der.size = der_size;
+        ptr += der_size;
+
+        if ((ret = pgnutls_x509_crt_init( &crt )) < 0) goto done;
+        if ((ret = pgnutls_x509_crt_import( crt, &der, GNUTLS_X509_FMT_DER )) < 0)
+        {
+            pgnutls_x509_crt_deinit( crt );
+            goto done;
+        }
+
+        if ((ret = pgnutls_pkcs12_bag_init( &bag )) < 0)
+        {
+            pgnutls_x509_crt_deinit( crt );
+            goto done;
+        }
+        ret = pgnutls_pkcs12_bag_set_crt( bag, crt );
