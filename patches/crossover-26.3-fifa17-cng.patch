+
+/* Convert a CNG BCRYPT_RSAFULLPRIVATE_BLOB (big-endian components) into the
+ * MS PRIVATEKEYBLOB layout (little-endian) that the unix side already parses,
+ * so both kinds of key take the same path from here on. */
+static BYTE *bcrypt_blob_to_ms_blob( const BYTE *src, DWORD src_size, DWORD *size_ret )
+{
+    const BCRYPT_RSAKEY_BLOB *rsa = (const BCRYPT_RSAKEY_BLOB *)src;
+    const BYTE *exp, *m, *p1, *p2, *e1, *e2, *coef, *d;
+    DWORD bitlen, full, half, size, i;
+    BLOBHEADER *hdr;
+    RSAPUBKEY *pub;
+    BYTE *out, *dst;
+
+    if (src_size < sizeof(*rsa)) return NULL;
+    if (rsa->Magic != BCRYPT_RSAFULLPRIVATE_MAGIC)
+    {
+        FIXME( "unexpected key blob magic %08lx\n", rsa->Magic );
+        return NULL;
+    }
+
+    /* Same bound, and for the same reason, as ms_blob_to_bcrypt_blob(). */
+    bitlen = rsa->BitLength;
+    if (bitlen < 512 || bitlen > 16384 || (bitlen % 16)) return NULL;
+    /* RSAPUBKEY.pubexp is a DWORD; a longer exponent cannot be represented, and
+     * truncating it would yield a valid-looking blob that is quietly wrong. */
+    if (!rsa->cbPublicExp || rsa->cbPublicExp > sizeof(pub->pubexp)) return NULL;
+
+    full = bitlen / 8;
+    half = bitlen / 16;
+    if (rsa->cbModulus != full || rsa->cbPrime1 != half || rsa->cbPrime2 != half) return NULL;
+    if (src_size < sizeof(*rsa) + rsa->cbPublicExp + bitlen * 9 / 16) return NULL;
+
+    exp  = src + sizeof(*rsa);
+    m    = exp + rsa->cbPublicExp;
+    p1   = m + full;
+    p2   = p1 + half;
+    e1   = p2 + half;
+    e2   = e1 + half;
+    coef = e2 + half;
+    d    = coef + half;
+
+    size = sizeof(*hdr) + sizeof(*pub) + bitlen * 9 / 16;   /* m, p, q, e1, e2, coef, d */
+    if (!(out = CryptMemAlloc( size ))) return NULL;
+
+    hdr = (BLOBHEADER *)out;
+    hdr->bType    = PRIVATEKEYBLOB;
+    hdr->bVersion = CUR_BLOB_VERSION;
+    hdr->reserved = 0;
+    hdr->aiKeyAlg = CALG_RSA_KEYX;
+
+    pub = (RSAPUBKEY *)(hdr + 1);
+    pub->magic  = RSA_MAGIC_KEY;
+    pub->bitlen = bitlen;
+    pub->pubexp = 0;
+    for (i = 0; i < rsa->cbPublicExp; i++)
+        pub->pubexp = (pub->pubexp << 8) | exp[i];
+
+    /* every component is stored most-significant byte first by CNG and
+     * least-significant byte first by CryptoAPI */
+    dst = (BYTE *)(pub + 1);
+    for (i = 0; i < full; i++) *dst++ = m[full - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = p1[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = p2[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = e1[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = e2[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = coef[half - 1 - i];
+    for (i = 0; i < full; i++) *dst++ = d[full - 1 - i];
+
+    *size_ret = size;
+    return out;
 }
 
+/* Pull the private key out of a certificate as an MS PRIVATEKEYBLOB.  A
+ * certificate minted through CNG carries an NCrypt key handle rather than a
+ * CryptoAPI provider, so both have to be handled. */
+static BYTE *export_private_key( PCCERT_CONTEXT cert, DWORD *size_ret )
+{
+    HCRYPTPROV_OR_NCRYPT_KEY_HANDLE prov = 0;
+    DWORD key_spec = 0, size = 0;
+    BOOL free_prov = FALSE;
+    HCRYPTKEY key = 0;
+    BYTE *blob = NULL;
+
+    /* CACHE_FLAG makes it consult CERT_KEY_CONTEXT, which is where a key
+     * attached through CERT_NCRYPT_KEY_HANDLE_PROP_ID lives; without it a
+     * freshly minted CNG certificate looks as though it has no key at all. */
+    if (!CryptAcquireCertificatePrivateKey( cert, CRYPT_ACQUIRE_CACHE_FLAG | CRYPT_ACQUIRE_SILENT_FLAG |
+                                            CRYPT_ACQUIRE_ALLOW_NCRYPT_KEY_FLAG, NULL, &prov, &key_spec,
+                                            &free_prov ))
+    {
+        TRACE( "no private key on this certificate: %08lx\n", GetLastError() );
+        return NULL;
+    }
+
+    if (key_spec == CERT_NCRYPT_KEY_SPEC)
+    {
+        SECURITY_STATUS status;
+        BYTE *cng = NULL;
+
+        status = NCryptExportKey( prov, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, NULL, 0, &size, 0 );
+        if (status || !size)
+        {
+            WARN( "NCryptExportKey sizing failed %08lx\n", status );
+            goto done;
+        }
+        if (!(cng = CryptMemAlloc( size ))) goto done;
+        status = NCryptExportKey( prov, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, cng, size, &size, 0 );
+        if (status)
+        {
+            WARN( "NCryptExportKey failed %08lx\n", status );
+            CryptMemFree( cng );
+            goto done;
+        }
+        blob = bcrypt_blob_to_ms_blob( cng, size, size_ret );
+        CryptMemFree( cng );
+        goto done;
+    }
+
+    if (!CryptGetUserKey( prov, key_spec ? key_spec : AT_KEYEXCHANGE, &key ))
+    {
+        WARN( "CryptGetUserKey failed %08lx\n", GetLastError() );
+        goto done;
+    }
