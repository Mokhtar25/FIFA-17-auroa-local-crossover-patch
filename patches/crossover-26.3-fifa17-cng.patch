+/* Mirror of bcrypt_blob_to_ms_blob(): turn the MS PRIVATEKEYBLOB the unix side
+ * produces into the CNG blob NCryptImportKey wants.  Components swap from
+ * least-significant-byte-first to most-significant-byte-first. */
+static BYTE *ms_blob_to_bcrypt_blob( const BYTE *src, DWORD src_size, DWORD *size_ret )
+{
+    const BLOBHEADER *hdr = (const BLOBHEADER *)src;
+    const RSAPUBKEY *pub;
+    const BYTE *m, *p1, *p2, *e1, *e2, *coef, *d;
+    BCRYPT_RSAKEY_BLOB *rsa;
+    DWORD bitlen, full, half, size, i, exp_len;
+    BYTE exp[4], *out, *dst;
+
+    if (src_size < sizeof(*hdr) + sizeof(*pub)) return NULL;
+    if (hdr->bType != PRIVATEKEYBLOB) return NULL;
+    pub = (const RSAPUBKEY *)(hdr + 1);
+    if (pub->magic != RSA_MAGIC_KEY) return NULL;
+
+    /* Bound bitlen before it reaches any arithmetic.  It is read straight out of
+     * the blob, and "bitlen * 9 / 16" below is evaluated in 32 bits, so it wraps:
+     * bitlen 477218589 makes that term 0 while full (bitlen/8) and half (bitlen/16)
+     * -- which do not wrap -- still drive the copy loops, and 256 MB is written
+     * into a 28-byte allocation.  The blob reaches here from PFXImportCertStore,
+     * so it is file content, not something we produced. */
+    bitlen = pub->bitlen;
+    if (bitlen < 512 || bitlen > 16384 || (bitlen % 16)) return NULL;
+
+    full = bitlen / 8;
+    half = bitlen / 16;
+    if (src_size < sizeof(*hdr) + sizeof(*pub) + bitlen * 9 / 16) return NULL;
+
+    exp[0] = (pub->pubexp >> 24) & 0xff;
+    exp[1] = (pub->pubexp >> 16) & 0xff;
+    exp[2] = (pub->pubexp >> 8) & 0xff;
+    exp[3] = pub->pubexp & 0xff;
+    for (exp_len = 0; exp_len < 3 && !exp[exp_len]; exp_len++) ;
+    exp_len = sizeof(exp) - exp_len;
+
+    m    = (const BYTE *)(pub + 1);
+    p1   = m + full;
+    p2   = p1 + half;
+    e1   = p2 + half;
+    e2   = e1 + half;
+    coef = e2 + half;
+    d    = coef + half;
+
+    size = sizeof(*rsa) + exp_len + bitlen * 9 / 16;
+    if (!(out = CryptMemAlloc( size ))) return NULL;
+
+    rsa = (BCRYPT_RSAKEY_BLOB *)out;
+    rsa->Magic       = BCRYPT_RSAFULLPRIVATE_MAGIC;
+    rsa->BitLength   = bitlen;
+    rsa->cbPublicExp = exp_len;
+    rsa->cbModulus   = full;
+    rsa->cbPrime1    = half;
+    rsa->cbPrime2    = half;
+
+    dst = out + sizeof(*rsa);
+    for (i = 0; i < exp_len; i++) *dst++ = exp[sizeof(exp) - exp_len + i];
+    for (i = 0; i < full; i++) *dst++ = m[full - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = p1[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = p2[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = e1[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = e2[half - 1 - i];
+    for (i = 0; i < half; i++) *dst++ = coef[half - 1 - i];
+    for (i = 0; i < full; i++) *dst++ = d[full - 1 - i];
+
+    *size_ret = size;
+    return out;
+}
