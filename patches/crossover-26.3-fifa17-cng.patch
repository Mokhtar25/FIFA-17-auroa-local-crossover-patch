+/* Reverse a little-endian MS key component into a big-endian gnutls datum. */
+static int ms_component_to_datum( const BYTE *src, unsigned int len, gnutls_datum_t *out )
+{
+    unsigned int i;
+
+    if (!(out->data = malloc( len ))) return -1;
+    out->size = len;
+    for (i = 0; i < len; i++) out->data[i] = src[len - 1 - i];
+    return 0;
+}
+
+/* Rebuild a gnutls private key from the MS PRIVATEKEYBLOB laid out by
+ * import_store_key() above: BLOBHEADER, RSAPUBKEY, then modulus, P, Q, e1, e2,
+ * u and d, each little-endian. */
+static int privkey_from_ms_blob( const void *blob, DWORD size, gnutls_x509_privkey_t *key_ret )
+{
+    const BLOBHEADER *hdr = blob;
+    const RSAPUBKEY *rsakey;
+    const BYTE *src;
+    gnutls_datum_t m = {0}, e = {0}, d = {0}, p = {0}, q = {0}, u = {0};
+    BYTE exp[4];
+    unsigned int bitlen, half, full;
+    int ret = -1;
+
+    if (size < sizeof(*hdr) + sizeof(*rsakey)) return -1;
+    if (hdr->bType != PRIVATEKEYBLOB) return -1;
+
+    rsakey = (const RSAPUBKEY *)(hdr + 1);
+    if (rsakey->magic != RSA_MAGIC_KEY) return -1;
+
+    bitlen = rsakey->bitlen;
+    full = bitlen / 8;
+    half = bitlen / 16;
+    if (!full || size < sizeof(*hdr) + sizeof(*rsakey) + bitlen * 9 / 16) return -1;
+
+    exp[0] = rsakey->pubexp & 0xff;
+    exp[1] = (rsakey->pubexp >> 8) & 0xff;
+    exp[2] = (rsakey->pubexp >> 16) & 0xff;
+    exp[3] = (rsakey->pubexp >> 24) & 0xff;
+
+    src = (const BYTE *)(rsakey + 1);
+    if (ms_component_to_datum( src, full, &m )) goto done; src += full;
+    if (ms_component_to_datum( src, half, &p )) goto done; src += half;
+    if (ms_component_to_datum( src, half, &q )) goto done; src += half;
+    src += half;   /* exponent1 - gnutls recomputes it */
+    src += half;   /* exponent2 - likewise */
+    if (ms_component_to_datum( src, half, &u )) goto done; src += half;
+    if (ms_component_to_datum( src, full, &d )) goto done;
+    if (ms_component_to_datum( exp, sizeof(exp), &e )) goto done;
+
+    if ((ret = pgnutls_x509_privkey_init( key_ret )) < 0) goto done;
+
+    /* gnutls wants u = p^-1 mod q; MS stores q^-1 mod p, so swap p and q. */
+    if ((ret = pgnutls_x509_privkey_import_rsa_raw( *key_ret, &m, &e, &d, &q, &p, &u )) < 0)
+    {
+        pgnutls_x509_privkey_deinit( *key_ret );
+        *key_ret = NULL;
+    }
+
+done:
+    free( m.data );
+    free( e.data );
+    free( d.data );
+    free( p.data );
+    free( q.data );
+    free( u.data );
+    return ret;
 }
 
+static NTSTATUS export_cert_store( void *args )
+{
+    struct export_cert_store_params *params = args;
+    gnutls_pkcs12_t p12 = NULL;
+    gnutls_x509_privkey_t key = NULL;
