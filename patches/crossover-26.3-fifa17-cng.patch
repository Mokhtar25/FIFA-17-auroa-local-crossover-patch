+    status = STATUS_SUCCESS;
+
+done:
+    if (ret < 0 && status == STATUS_INVALID_PARAMETER) pgnutls_perror( ret );
+    if (bag) pgnutls_pkcs12_bag_deinit( bag );
+    if (key) pgnutls_x509_privkey_deinit( key );
+    if (p12) pgnutls_pkcs12_deinit( p12 );
+    free( pwd );
+    return status;
+}
