+    if (__atomic_exchange_n( &av_reported, 1, __ATOMIC_ACQ_REL )) return;
+    if (NtQueryVirtualMemory( GetCurrentProcess(), (void *)rip, MemoryBasicInformation,
+                              &mbi, sizeof(mbi), NULL ))
+        return;
 
+    buf.len = 0;
+    ctxlog_str( &buf, "CTXAV" );
+    ctxlog_field( &buf, "rip", rip, 16 );
+    ctxlog_field( &buf, "alloc_base", (ULONG_PTR)mbi.AllocationBase, 16 );
+    ctxlog_field( &buf, "region", (ULONG_PTR)mbi.RegionSize, 16 );
+    ctxlog_field( &buf, "prot", mbi.Protect, 8 );
+    ctxlog_field( &buf, "alloc_prot", mbi.AllocationProtect, 8 );
+    ctxlog_field( &buf, "state", mbi.State, 8 );
+    ctxlog_field( &buf, "type", mbi.Type, 8 );
+    ctxlog_field( &buf, "access", rec->ExceptionInformation[0], 8 );
+    ctxlog_field( &buf, "target", rec->ExceptionInformation[1], 16 );
+    ctxlog_str( &buf, " code=" );
+    if (!NtReadVirtualMemory( GetCurrentProcess(), (void *)rip, code, sizeof(code), &got ))
+        for (i = 0; i < got; i++) ctxlog_hex( &buf, code[i], 2 );
+    ctxlog_char( &buf, '\n' );
+    ctxlog_emit( buf.data, buf.len );
+}
 
