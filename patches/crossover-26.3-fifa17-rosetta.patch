+static void drbp_report_av( ULONG_PTR rip, const EXCEPTION_RECORD *rec )
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    unsigned char code[24];
+    struct ctxlog_buf buf;
+    SIZE_T got = 0;
+    unsigned int i;
