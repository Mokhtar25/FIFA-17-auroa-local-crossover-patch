 /***********************************************************************
+ *              CX_DR_PERSIST - software persistence for foreign debug registers
+ *
+ * Measured on this machine: a mach thread_set_state( x86_DEBUG_STATE ) issued
+ * by the (native, non-translated) wineserver against a suspended Rosetta
+ * thread is accepted, and an immediate read-back returns the written values.
+ * The state is dropped once the target thread resumes, so the next
+ * NtGetContextThread reports all zeroes.  server/mach.c's is_rosetta() tests
+ * the wineserver's own process, which is native, so neither CW HACK 22131
+ * path is ever taken here.
+ *
+ * With CX_DR_PERSIST=1 the values written by a successful foreign
+ * NtSetContextThread are remembered per target thread and replayed into a
+ * later foreign NtGetContextThread, so a guest that arms a breakpoint and
+ * re-reads it from a different thread sees its own value.
+ *
+ * This makes the read-back consistent.  It does not make the hardware
+ * breakpoint fire; that remains impossible under Rosetta.  A/B lever only.
+ *
+ * CONTEXT_DEBUG_REGISTERS is (CONTEXT_AMD64 | 0x0010): test the bare 0x10 bit,
+ * never the constant, or every AMD64 context matches.
+ */
+
+#define DRCACHE_MAX 64
+#define DRCACHE_BIT 0x10
+
+static int drcache_enabled = -1;
+static volatile int drcache_lock;
+static unsigned int drcache_count;
+static struct
+{
+    ULONG_PTR tid;
+    DWORD64 dr0, dr1, dr2, dr3, dr6, dr7;
+} drcache[DRCACHE_MAX];
+
+static int drbp_mode(void);
+static void drcache_put( ULONG_PTR tid, DWORD64 dr0, DWORD64 dr1, DWORD64 dr2,
+                         DWORD64 dr3, DWORD64 dr6, DWORD64 dr7 );
+
+static BOOL drcache_on(void)
+{
+    if (drcache_enabled == -1)
+    {
+        const char *val = getenv( "CX_DR_PERSIST" );
+        drcache_enabled = (val && val[0] == '1');
+    }
+    /* Emulated breakpoints need a coherent virtual DR state: the guest's
+     * handler queries its own Dr0/Dr6/Dr7 after the trap and must not see the
+     * empty hardware state. */
+    return drcache_enabled != 0 || drbp_mode() == 2;
+}
+
+static void drcache_acquire(void)
+{
+    while (__atomic_exchange_n( &drcache_lock, 1, __ATOMIC_ACQUIRE )) continue;
+}
+
+static void drcache_release(void)
+{
+    __atomic_store_n( &drcache_lock, 0, __ATOMIC_RELEASE );
+}
+
+/* Key on the target thread id: handles to the same thread are opened, closed
+ * and renumbered between the calls we need to correlate. */
+static ULONG_PTR drcache_tid( HANDLE handle )
+{
+    THREAD_BASIC_INFORMATION info;
+
+    if (NtQueryInformationThread( handle, ThreadBasicInformation, &info, sizeof(info), NULL ))
+        return 0;
+    return (ULONG_PTR)info.ClientId.UniqueThread;
+}
+
+static void drcache_log( const char *tag, unsigned int event, ULONG_PTR tid, const CONTEXT *context )
+{
+    struct ctxlog_buf buf;
+
+    buf.len = 0;
+    ctxlog_str( &buf, "CTXDR " );
+    ctxlog_str( &buf, tag );
+    ctxlog_field( &buf, "event", event, 8 );
+    ctxlog_field( &buf, "tid", tid, 8 );
+    ctxlog_field( &buf, "dr0", context->Dr0, 16 );
+    ctxlog_field( &buf, "dr7", context->Dr7, 16 );
+    ctxlog_char( &buf, '\n' );
+    ctxlog_emit( buf.data, buf.len );
+}
+
+
+/* Dump the bytes a guest just armed an execute breakpoint on.  The watcher
+ * thread and its target are threads of the same process, so the address is
+ * readable from here; NtReadVirtualMemory is used so a bad address returns a
+ * status instead of faulting inside the instrumentation. */
+
+/* CX_DR_TRAP: reachability probe for an armed execute breakpoint.
+ *
+ * Rosetta silently never fires a hardware #DB, so arming Dr0/Dr7 has no
+ * observable effect.  With CX_DR_TRAP=1 the page holding the breakpoint
+ * address has its execute permission removed instead, turning any execution
+ * in that page into a page fault we can see.  One-shot: the first fault is
+ * logged and execute is restored, so the guest continues normally.
+ *
+ * A fault whose RIP equals the armed address proves the guest reaches the
+ * breakpoint and that only the trap delivery is missing.
+ */
+
+static int drbp_enabled = -1;
+static volatile ULONG_PTR drbp_addr;
+static volatile ULONG_PTR drbp_page;
+static volatile int drbp_armed;
+static volatile unsigned int drbp_hits;
+static volatile ULONG_PTR drbp_dr7;
+static volatile ULONG drbp_oldprot;
+
+static int drbp_mode(void)
+{
+    if (drbp_enabled == -1)
+    {
+        const char *val = getenv( "CX_DR_TRAP" );
+        drbp_enabled = val ? val[0] - '0' : 0;
+        if (drbp_enabled < 0 || drbp_enabled > 2) drbp_enabled = 0;
+    }
+    return drbp_enabled;
+}
+
+static BOOL drbp_on(void)
+{
+    return drbp_mode() != 0;
+}
+
+static void drbp_log( const char *tag, ULONG_PTR a, ULONG_PTR b, ULONG_PTR c )
+{
+    struct ctxlog_buf buf;
+
+    buf.len = 0;
+    ctxlog_str( &buf, "CTXBP " );
+    ctxlog_str( &buf, tag );
+    ctxlog_field( &buf, "a", a, 16 );
+    ctxlog_field( &buf, "b", b, 16 );
+    ctxlog_field( &buf, "c", c, 16 );
+    ctxlog_char( &buf, '\n' );
+    ctxlog_emit( buf.data, buf.len );
+}
+
+/* Non-executable counterpart of an executable protection, preserving
+ * read/write/copy-on-write semantics.  The guest reads its own page
+ * protections back through VirtualQuery, so the value it sees afterwards must
+ * be exactly what it was before. */
+static ULONG drbp_strip_exec( ULONG prot )
+{
+    switch (prot & 0xff)
+    {
+    case PAGE_EXECUTE:           return PAGE_NOACCESS;
+    case PAGE_EXECUTE_READ:      return PAGE_READONLY;
+    case PAGE_EXECUTE_READWRITE: return PAGE_READWRITE;
+    case PAGE_EXECUTE_WRITECOPY: return PAGE_WRITECOPY;
+    default:                     return 0;
+    }
+}
+
+static void drbp_arm( DWORD64 addr )
+{
+    void *base = (void *)(ULONG_PTR)(addr & ~(ULONG_PTR)0xfff);
+    void *query = base;
+    SIZE_T size = 0x1000;
+    MEMORY_BASIC_INFORMATION mbi;
+    ULONG old = 0, noexec;
+    NTSTATUS ret;
+
+    if (!addr || drbp_armed) return;
+
+    if (NtQueryVirtualMemory( GetCurrentProcess(), query, MemoryBasicInformation,
+                              &mbi, sizeof(mbi), NULL ))
+        return;
+    if (!(noexec = drbp_strip_exec( mbi.Protect )))
+    {
+        drbp_log( "arm-skip", (ULONG_PTR)addr, mbi.Protect, 0 );
+        return;
+    }
+
+    drbp_addr = (ULONG_PTR)addr;
+    drbp_hits = 0;
+    drbp_page = (ULONG_PTR)base;
+    drbp_oldprot = mbi.Protect;
+    ret = NtProtectVirtualMemory( GetCurrentProcess(), &base, &size, noexec, &old );
+    drbp_log( "arm", (ULONG_PTR)addr, (ULONG_PTR)mbi.Protect, (ULONG_PTR)ret );
+    if (!ret) drbp_armed = 1;
+}
+
+/* Called from segv_handler.
+ * 0 = not ours, 1 = ours, resume the guest, 2 = ours, raise a synthetic #DB. */
+static int drbp_handle_fault( ULONG_PTR fault_addr, ULONG_PTR rip )
+{
+    void *base;
+    SIZE_T size = 0x1000;
+    ULONG old = 0;
+    int deliver;
+
+    if (!drbp_armed) return 0;
+    if ((fault_addr & ~(ULONG_PTR)0xfff) != drbp_page &&
+        (rip & ~(ULONG_PTR)0xfff) != drbp_page) return 0;
+
+    drbp_armed = 0;
+    drbp_hits++;
+    base = (void *)drbp_page;
+    NtProtectVirtualMemory( GetCurrentProcess(), &base, &size, drbp_oldprot, &old );
+
+    deliver = (drbp_mode() == 2 && rip == drbp_addr);
+    if (deliver)
+        drcache_put( (ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread,
+                     drbp_addr, 0, 0, 0, 0x1, drbp_dr7 );
+    drbp_log( deliver ? "DELIVER" : (rip == drbp_addr ? "HIT-EXACT" : "hit"), rip, fault_addr, drbp_addr );
+    return deliver ? 2 : 1;
+}
+
+static void drcache_dump_target( unsigned int event, DWORD64 addr )
+{
+    unsigned char code[32];
+    struct ctxlog_buf buf;
+    SIZE_T got = 0;
+    NTSTATUS ret;
+    unsigned int i;
+
+    ret = NtReadVirtualMemory( GetCurrentProcess(), (void *)(ULONG_PTR)addr, code, sizeof(code), &got );
+
+    buf.len = 0;
+    ctxlog_str( &buf, "CTXDR code" );
+    ctxlog_field( &buf, "event", event, 8 );
+    ctxlog_field( &buf, "addr", addr, 16 );
+    ctxlog_field( &buf, "status", ret, 8 );
+    ctxlog_field( &buf, "got", got, 8 );
+    ctxlog_str( &buf, " bytes=" );
+    for (i = 0; i < got; i++) ctxlog_hex( &buf, code[i], 2 );
+    ctxlog_char( &buf, '\n' );
+    ctxlog_emit( buf.data, buf.len );
+}
+
+static void drcache_put( ULONG_PTR tid, DWORD64 dr0, DWORD64 dr1, DWORD64 dr2,
+                         DWORD64 dr3, DWORD64 dr6, DWORD64 dr7 )
+{
+    unsigned int i;
+
+    if (!tid) return;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++) if (drcache[i].tid == tid) break;
+    if (i == drcache_count)
+    {
+        if (drcache_count == DRCACHE_MAX)
+        {
+            drcache_release();
+            return;
+        }
+        drcache_count++;
+        drcache[i].tid = tid;
+    }
+    drcache[i].dr0 = dr0;
+    drcache[i].dr1 = dr1;
+    drcache[i].dr2 = dr2;
+    drcache[i].dr3 = dr3;
+    drcache[i].dr6 = dr6;
+    drcache[i].dr7 = dr7;
+    drcache_release();
+}
+
+static void drcache_store( HANDLE handle, unsigned int event, const CONTEXT *context )
+{
+    ULONG_PTR tid = drcache_tid( handle );
+    unsigned int i;
+
+    if (!tid) return;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++) if (drcache[i].tid == tid) break;
+    if (i == drcache_count)
+    {
+        if (drcache_count == DRCACHE_MAX)
+        {
+            drcache_release();
+            return;
+        }
+        drcache_count++;
+        drcache[i].tid = tid;
+    }
+    drcache[i].dr0 = context->Dr0;
+    drcache[i].dr1 = context->Dr1;
+    drcache[i].dr2 = context->Dr2;
+    drcache[i].dr3 = context->Dr3;
+    drcache[i].dr6 = context->Dr6;
+    drcache[i].dr7 = context->Dr7;
+    drcache_release();
+    drcache_log( "store", event, tid, context );
+}
+
+static void drcache_apply( HANDLE handle, unsigned int event, CONTEXT *context )
+{
+    ULONG_PTR tid = drcache_tid( handle );
+    unsigned int i;
+    BOOL found = FALSE;
+
+    if (!tid) return;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++)
+    {
+        if (drcache[i].tid != tid) continue;
+        context->Dr0 = drcache[i].dr0;
+        context->Dr1 = drcache[i].dr1;
+        context->Dr2 = drcache[i].dr2;
+        context->Dr3 = drcache[i].dr3;
+        context->Dr6 = drcache[i].dr6;
+        context->Dr7 = drcache[i].dr7;
+        found = TRUE;
+        break;
+    }
+    drcache_release();
+    if (found) drcache_log( "apply", event, tid, context );
+}
+
+
+NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
+{
+    NTSTATUS ret;
+    unsigned int event = __atomic_add_fetch( &ctxlog_next_event, 1, __ATOMIC_RELAXED );
+    BOOL top = !ctxlog_depth++;
+    DWORD requested = context ? context->ContextFlags : 0;
+
+    if (!context)
+    {
+        ret = STATUS_ACCESS_VIOLATION;
+        ctxlog_dump( "SET", event, 0, handle, context, requested, ret );
+        ctxlog_depth--;
+        return ret;
+    }
+    ret = ctxlog_set_context_thread( handle, context );
+    ctxlog_dump( "SET", event, 0, handle, context, requested, ret );
+    if (!ret && handle != GetCurrentThread() && (requested & DRCACHE_BIT))
+    {
+        if (context->Dr7 & 0xff)
+        {
+            drcache_dump_target( event, context->Dr0 );
+            if (drbp_on())
+            {
+                drbp_dr7 = (ULONG_PTR)context->Dr7;
+                drbp_arm( context->Dr0 );
+            }
+        }
+        if (drcache_on()) drcache_store( handle, event, context );
+    }
+    if (top && !ret && handle != GetCurrentThread())
+    {
+        ctxlog_pending.handle = handle;
+        ctxlog_pending.set_event = event;
+        ctxlog_pending.active = TRUE;
+    }
+    ctxlog_depth--;
+    return ret;
+}
+
