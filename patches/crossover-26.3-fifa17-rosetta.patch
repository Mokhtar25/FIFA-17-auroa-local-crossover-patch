+
+/* Find the gate's cfg (r15). Its +0x71 holds the 8-byte section NAME the gate
+ * demands and +0x7c the Characteristics, with +0x60 the slot offset. A section
+ * name starts with '.', which makes cfg findable on the stack. */
+static void cxscan_find_cfg( void *conn, void *modbase )
+{
+    void **sp = (void **)&sp;
+    int i;
+
+    for (i = 0; i < 1024; i++)
+    {
+        char *cand = (char *)sp[i];
+        char nm[9];
+        DWORD off, chars;
+        void *slotval = NULL;
+
+        if (!cand || ((ULONG_PTR)cand & 7)) continue;
+        __TRY
+        {
+            memcpy( nm, cand + 0x71, 8 );
+            off   = *(DWORD *)(cand + 0x60);
+            chars = *(DWORD *)(cand + 0x7c);
+            if (modbase && off && off < 0x20000000)
+                slotval = *(void **)((char *)modbase + off);
+        }
+        __EXCEPT_ALL
+        {
+            continue;
+        }
+        __ENDTRY
+        nm[8] = 0;
+        if (nm[0] != '.') continue;
+        {
+            /* validate() also requires VirtualQuery(slot).Protect == cfg[0x80],
+             * State == MEM_COMMIT and Type == MEM_IMAGE. Measure all of them. */
+            MEMORY_BASIC_INFORMATION mbi;
+            SIZE_T got = 0;
+            DWORD want_prot = 0;
+
+            __TRY { want_prot = *(DWORD *)(cand + 0x80); } __EXCEPT_ALL { } __ENDTRY
+            memset( &mbi, 0, sizeof(mbi) );
+            if (modbase && off)
+                NtQueryVirtualMemory( GetCurrentProcess(), (char *)modbase + off,
+                                      MemoryBasicInformation, &mbi, sizeof(mbi), &got );
+            ERR( "CXPROT slot=%p State=%08lx Type=%08lx Protect=%08lx AllocProtect=%08lx AllocBase=%p RegionSize=%Ix | cfg_wants_protect=%08lx %s\n",
+                 (char *)modbase + off, mbi.State, mbi.Type, mbi.Protect, mbi.AllocationProtect,
+                 mbi.AllocationBase, mbi.RegionSize, want_prot,
+                 mbi.Protect == want_prot ? "MATCH" : "*** PROTECT MISMATCH ***" );
+        }
+        {
+            /* dump the 8 name bytes raw: the real section name has an embedded
+             * NUL (".data\0m\0"), so any %s print stops early and hides a
+             * mismatch in the trailing bytes that the 8-byte compare sees. */
+            const unsigned char *b = (const unsigned char *)(cand + 0x71);
+            ERR( "CXCFG  cand=%p wants name=%02x%02x%02x%02x%02x%02x%02x%02x ('%s') chars=%08lx slot_off=%08lx slotval=%p %s\n",
+                 cand, b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7], nm, chars, off, slotval,
+                 slotval == conn ? "(slot holds &connect)" : "(slot NOT &connect)" );
+        }
+    }
+}
+
+static void cxscan_report( HMODULE ws2, void *target )
+{
+    PEB_LDR_DATA *ldr = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *mark = &ldr->InMemoryOrderModuleList, *entry;
+
+    ANSI_STRING ga;
+    void *gai = NULL;
+
+    /* The shim checks a resolver slot (getaddrinfo) before the connect slot, and
+     * the resolver check passes. Counting both per module identifies which module
+     * it is actually scanning: the target is the one holding getaddrinfo. */
+    RtlInitAnsiString( &ga, "getaddrinfo" );
+    LdrGetProcedureAddress( ws2, &ga, 0, &gai );
+
+    ERR( "CXSCAN &connect=%p &getaddrinfo=%p (shim needs exactly 1 hit)\n", target, gai );
+
+    for (entry = mark->Flink; entry != mark; entry = entry->Flink)
+    {
+        LDR_DATA_TABLE_ENTRY *mod = CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks );
+        char *base = (char *)mod->DllBase;
+        IMAGE_NT_HEADERS *nt;
+        IMAGE_SECTION_HEADER *sec;
+        LONG64 hits = 0, ghits = 0;
+        UINT i;
+
+        if (!base) continue;
+        nt = RtlImageNtHeader( (HMODULE)base );
+        if (!nt) continue;
+        sec = IMAGE_FIRST_SECTION( nt );
+
+        for (i = 0; i < nt->FileHeader.NumberOfSections; i++)
+        {
+            char *p = base + sec[i].VirtualAddress;
+            SIZE_T n = sec[i].Misc.VirtualSize, off;
+
+            /* the shim tests bit 30 == IMAGE_SCN_MEM_READ, not WRITE */
+            if (!(sec[i].Characteristics & IMAGE_SCN_MEM_READ)) continue;
+            if (n < sizeof(void *)) continue;
+            for (off = 0; off + sizeof(void *) <= n; off += sizeof(void *))
+            {
+                void *v = *(void **)(p + off);
+                if (v != target && !(gai && v == gai)) continue;
+                if (v == target) hits++; else ghits++;
+                /* print the section as the shim sees it in memory: it matches
+                 * the 8-byte name and the characteristics against its config. */
+                ERR( "CXSCAN     %s slot in section name=%02x%02x%02x%02x%02x%02x%02x%02x '%.8s' chars=%08lx rva=%08lx (module %s)\n",
+                     v == target ? "connect    " : "getaddrinfo",
+                     sec[i].Name[0],sec[i].Name[1],sec[i].Name[2],sec[i].Name[3],
+                     sec[i].Name[4],sec[i].Name[5],sec[i].Name[6],sec[i].Name[7],
+                     (const char *)sec[i].Name, (DWORD)sec[i].Characteristics,
+                     (DWORD)(sec[i].VirtualAddress + off), debugstr_w(mod->BaseDllName.Buffer) );
+            }
+        }
+        if (hits || ghits)
+            ERR( "CXSCAN   %-34s base=%p connect=%I64d getaddrinfo=%I64d %s\n",
+                 debugstr_w(mod->BaseDllName.Buffer), base, hits, ghits,
+                 hits == 1 ? "(connect gate PASS)" : "(connect gate FAIL)" );
+    }
+    cxscan_find_arg1();
+    cxscan_find_cfg( target, (void *)0x140000000 );
+    cxscan_resolved_in( ws2, L"stp-origin_emu.dll" );
+    ERR( "CXSCAN end\n" );
+}
