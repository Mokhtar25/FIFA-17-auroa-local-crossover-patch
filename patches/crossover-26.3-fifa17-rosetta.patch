 /***********************************************************************
+ *              CTXLOG instrumentation (context structure tracing)
+ *
+ * Unconditional stderr logging of the CONTEXT contents on every
+ * NtGetContextThread / NtSetContextThread.  Instrumentation only:
+ * invisible to the guest process.  The fixed-width formatter and write(2)
+ * avoid stdio and allocator state because these APIs are also used from
+ * signal paths.
+ */
+
+static volatile unsigned int ctxlog_next_event;
+static __thread unsigned int ctxlog_depth;
+static __thread struct
+{
+    HANDLE handle;
+    unsigned int set_event;
+    BOOL active;
+} ctxlog_pending;
+
+C_ASSERT( sizeof(CONTEXT) == 0x4d0 );
+C_ASSERT( offsetof(CONTEXT, ContextFlags) == 0x30 );
+C_ASSERT( offsetof(CONTEXT, MxCsr) == 0x34 );
+C_ASSERT( offsetof(CONTEXT, FltSave) == 0x100 );
+C_ASSERT( sizeof(XSAVE_FORMAT) == 0x200 );
+C_ASSERT( sizeof(CONTEXT_EX) == 0x20 );
+
+struct ctxlog_buf
+{
+    char data[4096];
+    unsigned int len;
+};
+
+/* Signal-safe one-shot line emitter.  NtGetContextThread is reachable from
+ * setup_raise_exception() inside the SIGTRAP/SIGSEGV handlers, so stdio (and
+ * its stderr lock) must not be used here: format into a stack buffer and issue
+ * a single write(2), which also keeps lines from interleaving between threads. */
+static void ctxlog_emit( const char *buf, unsigned int len )
+{
+    while (len > 0)
+    {
+        ssize_t n = write( 2, buf, len );
+        if (n <= 0) break;
+        buf += n;
+        len -= n;
+    }
+}
+
+static void ctxlog_char( struct ctxlog_buf *buf, char ch )
+{
+    if (buf->len < sizeof(buf->data)) buf->data[buf->len++] = ch;
+}
+
+static void ctxlog_str( struct ctxlog_buf *buf, const char *str )
+{
+    while (*str) ctxlog_char( buf, *str++ );
+}
+
+static void ctxlog_hex( struct ctxlog_buf *buf, ULONG64 value, unsigned int digits )
+{
+    static const char hex[] = "0123456789abcdef";
+
+    while (digits) ctxlog_char( buf, hex[(value >> (--digits * 4)) & 0xf] );
+}
+
+static void ctxlog_field( struct ctxlog_buf *buf, const char *name, ULONG64 value, unsigned int digits )
+{
+    ctxlog_char( buf, ' ' );
+    ctxlog_str( buf, name );
+    ctxlog_char( buf, '=' );
+    ctxlog_hex( buf, value, digits );
+}
+
+static ULONG64 ctxlog_hash( const void *ptr, unsigned int size )
+{
+    const unsigned char *bytes = ptr;
+    ULONG64 hash = 0xcbf29ce484222325ULL;
+
+    while (size--)
+    {
+        hash ^= *bytes++;
+        hash *= 0x100000001b3ULL;
+    }
+    return hash;
+}
+
+static void ctxlog_dump_bytes( const char *tag, unsigned int event, const void *ptr,
+                               unsigned int size )
+{
+    const unsigned char *bytes = ptr;
+    unsigned int offset = 0;
+
+    while (offset < size)
+    {
+        struct ctxlog_buf buf = {{0}, 0};
+        unsigned int end = offset + 128;
+
+        if (end > size) end = size;
+        ctxlog_str( &buf, "CTXLOG " );
+        ctxlog_str( &buf, tag );
+        ctxlog_field( &buf, "event", event, 8 );
+        ctxlog_field( &buf, "offset", offset, 8 );
+        ctxlog_str( &buf, " bytes=" );
+        while (offset < end) ctxlog_hex( &buf, bytes[offset++], 2 );
+        ctxlog_char( &buf, '\n' );
+        ctxlog_emit( buf.data, buf.len );
+    }
+}
+
+static void ctxlog_dump( const char *tag, unsigned int event, unsigned int pair,
+                         HANDLE handle, const CONTEXT *context, DWORD requested,
+                         NTSTATUS status )
+{
+    struct ctxlog_buf buf = {{0}, 0};
+    DWORD flags = context ? context->ContextFlags : 0;
+
+    ctxlog_str( &buf, "CTXLOG " );
+    ctxlog_str( &buf, tag );
+    ctxlog_field( &buf, "event", event, 8 );
+    ctxlog_field( &buf, "pair", pair, 8 );
+    ctxlog_field( &buf, "tid", (ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread, 8 );
+    ctxlog_field( &buf, "handle", (ULONG_PTR)handle, 16 );
+    ctxlog_field( &buf, "context", (ULONG_PTR)context, 16 );
+    ctxlog_field( &buf, "requested", requested, 8 );
+    ctxlog_field( &buf, "flags", flags, 8 );
+    ctxlog_field( &buf, "groups", flags & 0x5f, 2 );
+    ctxlog_field( &buf, "status", status, 8 );
+
+    if (context && (flags & 0x01))
+    {
+        ctxlog_field( &buf, "rip", context->Rip, 16 );
+        ctxlog_field( &buf, "rsp", context->Rsp, 16 );
+        ctxlog_field( &buf, "eflags", context->EFlags, 8 );
+    }
+    if (context && (flags & 0x02))
+    {
+        ctxlog_field( &buf, "rax", context->Rax, 16 );
+        ctxlog_field( &buf, "rbx", context->Rbx, 16 );
+        ctxlog_field( &buf, "rcx", context->Rcx, 16 );
+        ctxlog_field( &buf, "rdx", context->Rdx, 16 );
+        ctxlog_field( &buf, "rbp", context->Rbp, 16 );
+        ctxlog_field( &buf, "rsi", context->Rsi, 16 );
+        ctxlog_field( &buf, "rdi", context->Rdi, 16 );
+        ctxlog_field( &buf, "r8", context->R8, 16 );
+        ctxlog_field( &buf, "r9", context->R9, 16 );
+        ctxlog_field( &buf, "r10", context->R10, 16 );
+        ctxlog_field( &buf, "r11", context->R11, 16 );
+        ctxlog_field( &buf, "r12", context->R12, 16 );
+        ctxlog_field( &buf, "r13", context->R13, 16 );
+        ctxlog_field( &buf, "r14", context->R14, 16 );
+        ctxlog_field( &buf, "r15", context->R15, 16 );
+    }
+    if (context && (flags & 0x04))
+    {
+        ctxlog_field( &buf, "cs", context->SegCs, 4 );
+        ctxlog_field( &buf, "ds", context->SegDs, 4 );
+        ctxlog_field( &buf, "es", context->SegEs, 4 );
+        ctxlog_field( &buf, "fs", context->SegFs, 4 );
+        ctxlog_field( &buf, "gs", context->SegGs, 4 );
+        ctxlog_field( &buf, "ss", context->SegSs, 4 );
+    }
+    if (context && (flags & 0x08))
+    {
+        ctxlog_field( &buf, "mxcsr", context->MxCsr, 8 );
+        ctxlog_field( &buf, "fp_mxcsr", context->FltSave.MxCsr, 8 );
+        ctxlog_field( &buf, "mxcsr_mask", context->FltSave.MxCsr_Mask, 8 );
+        ctxlog_field( &buf, "fp_hash", ctxlog_hash( &context->FltSave, sizeof(context->FltSave) ), 16 );
+    }
+    if (context && (flags & 0x10))
+    {
+        ctxlog_field( &buf, "dr0", context->Dr0, 16 );
+        ctxlog_field( &buf, "dr1", context->Dr1, 16 );
+        ctxlog_field( &buf, "dr2", context->Dr2, 16 );
+        ctxlog_field( &buf, "dr3", context->Dr3, 16 );
+        ctxlog_field( &buf, "dr6", context->Dr6, 16 );
+        ctxlog_field( &buf, "dr7", context->Dr7, 16 );
+    }
+    ctxlog_field( &buf, "xfeatures", xstate_extended_features, 16 );
+    ctxlog_field( &buf, "xstate_size", xstate_size, 8 );
+    ctxlog_char( &buf, '\n' );
+    ctxlog_emit( buf.data, buf.len );
+
+    if (context && (flags & 0x08)) ctxlog_dump_bytes( "FP", event, &context->FltSave, sizeof(context->FltSave) );
+
+    /* Wine itself dereferences this descriptor only when extended features are
+     * enabled.  Follow that rule so a caller that supplied exactly sizeof(CONTEXT)
+     * cannot make the logger read beyond its buffer on legacy-only Rosetta. */
+    if (context && !status && (flags & 0x40) && xstate_extended_features)
+    {
+        const CONTEXT_EX *context_ex = (const CONTEXT_EX *)(context + 1);
+        LONG offset = context_ex->XState.Offset;
+        DWORD length = context_ex->XState.Length;
+        struct ctxlog_buf xbuf = {{0}, 0};
+
+        ctxlog_str( &xbuf, "CTXLOG XSTATE" );
+        ctxlog_field( &xbuf, "event", event, 8 );
+        ctxlog_field( &xbuf, "all_off", (ULONG)context_ex->All.Offset, 8 );
+        ctxlog_field( &xbuf, "all_len", context_ex->All.Length, 8 );
+        ctxlog_field( &xbuf, "legacy_off", (ULONG)context_ex->Legacy.Offset, 8 );
+        ctxlog_field( &xbuf, "legacy_len", context_ex->Legacy.Length, 8 );
+        ctxlog_field( &xbuf, "xstate_off", (ULONG)offset, 8 );
+        ctxlog_field( &xbuf, "xstate_len", length, 8 );
+        if (length >= sizeof(XSAVE_AREA_HEADER) && length <= xstate_size)
+        {
+            const XSAVE_AREA_HEADER *xs = (const XSAVE_AREA_HEADER *)((const char *)context_ex + offset);
+            ctxlog_field( &xbuf, "mask", xs->Mask, 16 );
+            ctxlog_field( &xbuf, "compaction", xs->CompactionMask, 16 );
+            ctxlog_field( &xbuf, "hash", ctxlog_hash( xs, length ), 16 );
+        }
+        ctxlog_char( &xbuf, '\n' );
+        ctxlog_emit( xbuf.data, xbuf.len );
+        if (length >= sizeof(XSAVE_AREA_HEADER) && length <= xstate_size)
+            ctxlog_dump_bytes( "XBYTES", event, (const char *)context_ex + offset, length );
+    }
+}
+
