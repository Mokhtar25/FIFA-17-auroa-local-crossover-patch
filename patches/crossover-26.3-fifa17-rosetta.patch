+/* CXSCAN: replicate the Aurora shim's connect-slot scan.
+ *
+ * The shim locates the IAT slot to hook by scanning a module's WRITABLE
+ * sections for 8-byte-aligned pointers equal to &ws2_32!connect, and it
+ * demands EXACTLY ONE match. Under Wine that check fails and the redirect is
+ * rolled back, so the game talks to the dead EA servers.
+ *
+ * The gate calls no API between resolving connect and reaching its verdict,
+ * so relay tracing cannot show the count. Here we are inside the same process
+ * at the moment it resolves "connect", with the full module list in hand, so
+ * we can just run the same scan and print what it would have seen.
+ *
+ * Enabled with CX_SCAN_CONNECT=1.
+ */
+static int cxscan_enabled = -1;
+
+static BOOL cxscan_on(void)
+{
+    /* Unconditional in this diagnostic build. An env gate was tried first but
+     * CrossOver's wrapper does not propagate arbitrary environment variables
+     * through to the PE side -- the same trap that makes WINEDEBUG useless
+     * there (see HANDOFF.md section 11). Only fires on lookups of "connect",
+     * so the noise is a handful of lines per process. */
+    return TRUE;
 }
 
 
+
+/* Print every ws2_32 export whose address appears in the given module. Shows
+ * exactly what the packed Origin emulator has resolved at gate time, and so
+ * whether "connect" is merely late or genuinely never resolved. */
+static void cxscan_resolved_in( HMODULE ws2, const WCHAR *want )
+{
+    PEB_LDR_DATA *ldr = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *mark = &ldr->InMemoryOrderModuleList, *entry;
+    IMAGE_EXPORT_DIRECTORY *ex;
+    DWORD sz, *names, *funcs;
+    WORD *ords;
+    UINT k;
+
+    if (!(ex = RtlImageDirectoryEntryToData( ws2, TRUE, IMAGE_DIRECTORY_ENTRY_EXPORT, &sz ))) return;
+    names = (DWORD *)((char *)ws2 + ex->AddressOfNames);
+    ords  = (WORD  *)((char *)ws2 + ex->AddressOfNameOrdinals);
+    funcs = (DWORD *)((char *)ws2 + ex->AddressOfFunctions);
+
+    for (entry = mark->Flink; entry != mark; entry = entry->Flink)
+    {
+        LDR_DATA_TABLE_ENTRY *mod = CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks );
+        char *base = (char *)mod->DllBase;
+        IMAGE_NT_HEADERS *nt;
+        IMAGE_SECTION_HEADER *sec;
+        UINT i;
+
+        if (!base || !mod->BaseDllName.Buffer) continue;
+        if (wcsicmp( mod->BaseDllName.Buffer, want )) continue;
+        if (!(nt = RtlImageNtHeader( (HMODULE)base ))) continue;
+        sec = IMAGE_FIRST_SECTION( nt );
+        ERR( "CXSCAN resolved ws2_32 exports inside %s:\n", debugstr_w(want) );
+        for (k = 0; k < ex->NumberOfNames; k++)
+        {
+            void *addr = (char *)ws2 + funcs[ords[k]];
+            const char *nm = (const char *)ws2 + names[k];
+            for (i = 0; i < nt->FileHeader.NumberOfSections; i++)
+            {
+                char *p = base + sec[i].VirtualAddress;
+                SIZE_T n = sec[i].Misc.VirtualSize, off;
+                if (!(sec[i].Characteristics & IMAGE_SCN_MEM_READ)) continue;
+                for (off = 0; off + sizeof(void *) <= n; off += sizeof(void *))
+                    if (*(void **)(p + off) == addr)
+                        ERR( "CXSCAN     %-20s at '%.8s'+%08lx\n", nm,
+                             (const char *)sec[i].Name, (DWORD)off );
+            }
+        }
+        ERR( "CXSCAN resolved-list end\n" );
+    }
+}
+
+
+/* Identify the gate's arg1 without guessing. The gate holds it in rsi (a
+ * callee-saved register), so by the time we are inside LdrGetProcedureAddress
+ * the value is saved somewhere on the stack below us. arg1 is a descriptor
+ * {base@0x00, size@0x0c}; scan the stack for any qword that points at such a
+ * struct whose base matches a loaded module and whose size matches that
+ * module's SizeOfImage. That pins the scanned module exactly. */
+static void cxscan_find_arg1( void )
+{
+    PEB_LDR_DATA *ldr = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *mark = &ldr->InMemoryOrderModuleList, *entry;
+    void **sp;
+    int i;
+
+    sp = (void **)&sp;
+    for (i = 0; i < 1024; i++)
+    {
+        void *cand = sp[i], *base;
+        DWORD size;
+
+        if (!cand || ((ULONG_PTR)cand & 7)) continue;
+        __TRY
+        {
+            base = *(void **)cand;
+            size = *(DWORD *)((char *)cand + 0x0c);
+        }
+        __EXCEPT_ALL
+        {
+            continue;
+        }
+        __ENDTRY
+        if (!base) continue;
+
+        for (entry = mark->Flink; entry != mark; entry = entry->Flink)
+        {
+            LDR_DATA_TABLE_ENTRY *mod = CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks );
+            IMAGE_NT_HEADERS *nt;
+            if (mod->DllBase != base) continue;
+            nt = RtlImageNtHeader( (HMODULE)base );
+            ERR( "CXARG1 stack[%d]=%p -> {base=%p size=%08lx} module=%s imagesize=%08lx %s\n",
+                 i, cand, base, size, debugstr_w(mod->BaseDllName.Buffer),
+                 nt ? nt->OptionalHeader.SizeOfImage : 0,
+                 (nt && size == nt->OptionalHeader.SizeOfImage) ? "*** SIZE MATCHES ***" : "" );
+        }
+    }
+}
