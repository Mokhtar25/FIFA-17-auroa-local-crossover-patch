+ * +4); call through a register or memory, ret, push, pop, enter, leave,
+ * pushad and the string instructions step correctly.  The emulation steps
+ * every instruction it runs on a page it has stripped, so it has to undo
+ * this: remember the instruction before the step and fix the stack after it. */
+static void xbp_note_call( ucontext_t *ucontext, int t )
+{
+    BYTE op = 0;
+
+    xbp_thread[t].call_ret = 0;
+    if (!is_wow64() || CS_sig(ucontext) == cs64_sel) return;
+    if (NtReadVirtualMemory( GetCurrentProcess(), (void *)RIP_sig(ucontext), &op, 1, NULL ) || op != 0xe8)
+        return;
+    xbp_thread[t].call_sp = (DWORD)RSP_sig(ucontext);
+    xbp_thread[t].call_ret = (DWORD)RIP_sig(ucontext) + 5;
+}
+
+static void xbp_fix_call( ucontext_t *ucontext, int t )
+{
+    ULONG_PTR sp = RSP_sig(ucontext);
+    DWORD ret = xbp_thread[t].call_ret;
