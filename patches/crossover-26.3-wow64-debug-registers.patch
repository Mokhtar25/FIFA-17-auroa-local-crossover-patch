+/* Mode 3: Windows reports RF set in the context of a UD2 or an access
+ * violation (measured on Windows by tests/drbp/wow32_probe.c), as the CPU
+ * pushes it with a fault.  Rosetta's frame has no RF, so the next 32-bit
+ * context read after such an exception adds it.  An instruction-breakpoint
+ * #DB is the exception: its delivered context has RF clear there, so it is
+ * not marked here at all; the resume's run-once is the RF the handler sets. */
+static __thread int cx_wow_fault_rf;
+
+/* Mode 3: the Dr6 of the #DB being delivered to a 32-bit guest, when it names
+ * a hit (B0-B3).  The delivery reaches xbp_apply_wow64 as a context write, and
+ * that is told from the handler's own continue -- which must drop the status,
+ * as Windows does -- by carrying exactly this value once.  An execute
+ * breakpoint is also recognisable by Eip sitting on it; a data trap, which
+ * reports the next instruction, is not. */
+static __thread DWORD cx_wow_deliver_dr6;
+
+/* The same for a context written through the wow64 path, where the guest's
+ * debug registers are 32 bits wide and its code address lives in Eip.  The
+ * emulation arms the same pages; only the shape of the context differs. */
+static void xbp_apply_wow64( HANDLE handle, const I386_CONTEXT *context, BOOL self )
+{
+    CONTEXT ctx;
+
+    memset( &ctx, 0, sizeof(ctx) );
+    ctx.ContextFlags = CONTEXT_CONTROL | CONTEXT_DEBUG_REGISTERS;
+    ctx.Dr0 = context->Dr0;
+    ctx.Dr1 = context->Dr1;
+    ctx.Dr2 = context->Dr2;
+    ctx.Dr3 = context->Dr3;
+    /* Measured on Windows (tests/drbp/wow32_probe.c): Dr7 reads back with only
+     * its legal bits, and a continued context does not carry the hit's Dr6
+     * status forward; later exceptions report it cleared, or 0 once disarmed.
+     * The delivery of a hit comes through here too, with Eip on the breakpoint
+     * its status bit names, and a single-step's BS is left as it was. */
+    ctx.Dr7 = context->Dr7 & 0xffff0155;
+    ctx.Dr6 = context->Dr6;
+    if (!(context->Dr6 & 0x4000) &&
+        !(cx_wow_deliver_dr6 && context->Dr6 == cx_wow_deliver_dr6) &&
+        !((context->Dr6 & 1) && context->Eip == context->Dr0) &&
+        !((context->Dr6 & 2) && context->Eip == context->Dr1) &&
+        !((context->Dr6 & 4) && context->Eip == context->Dr2) &&
+        !((context->Dr6 & 8) && context->Eip == context->Dr3))
+        ctx.Dr6 = (ctx.Dr7 & 0xff) ? 0xffff0ff0 : 0;
+    cx_wow_deliver_dr6 = 0;
+    ctx.EFlags = context->EFlags;
+    ctx.Rip = context->Eip;
+    /* Data watchpoints go through the same page-protection path as a 64-bit
+     * guest's: the faulting access is decoded (xbp_decode_load knows the
+     * 32-bit addressing rules for a wow64 guest's code), stepped over under TF,
+     * and the #DB is delivered after it.  Dr0-3 are zero-extended addresses. */
+    xbp_sync( drcache_tid( handle ), &ctx, self );
+    /* the native path keeps both copies in step for mode 3, and a later
+     * GetThreadContext reads the cache first: an arm on another thread has
+     * only the cache (that thread's data is not writable from here) */
+    drcache_store( handle, 0, &ctx );
