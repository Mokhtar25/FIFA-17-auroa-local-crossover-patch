+/* Mode 3, 32-bit guests: the selectors a Windows wow64 thread reports in the
+ * context its exception handler is handed are cs=0x23, ss/ds/es/gs=0x2b, fs=0x53
+ * (measured on Windows 11 build 26200 by tests/drbp/wow32_probe.c); under Rosetta
+ * they are cs=0x107 (an LDT entry), ss/ds/es/gs=0x23, fs=0x10f.  Guest code that
+ * tests CONTEXT.SegCs against 0x23 -- the usual wow64 check -- sees the
+ * difference.  The real selectors stay in the CPU area and are what the thread
+ * resumes with: the Windows values are given out for the one read the exception
+ * dispatch makes (set in setup_raise_exception, consumed by the next 32-bit
+ * context read), and are translated back when a context comes in.  Other reads
+ * are left alone: widening this to every GetThreadContext broke wow64's own
+ * start-up, which compares the CPU area's cs with cs32_sel. */
+static __thread int cx_wow_seg_lie;
+/* bit n of CX_SEGLIE selects cs ss ds es fs gs.  The default leaves ss out: a
+ * Windows-valued ss (0x2b) in the delivered context makes the next nested
+ * exception dispatch from inside a handler (tests/trapstorm phase 2, the
+ * protector's own AV) lose its stack -- "Exception frame is not in stack
+ * limits" -- and kills the process.  Cause not found; cs, ds, es, fs and gs
+ * are safe (trapstorm 66/66) and do not change what the game does. */
+static int cx_wow_seg_mask(void)
+{
+    static int mask = -1;
+    if (mask == -1)
+    {
+        const char *v = getenv( "CX_SEGLIE" );
+        mask = v && v[0] ? (int)strtol( v, NULL, 0 ) : 0x3d;
+    }
+    return mask;
+}
+#define CXSEG(bit,lie,real) ((cx_wow_seg_lie && (cx_wow_seg_mask() & (bit))) ? (lie) : (real))
+
+static inline WORD cx_wow_seg_in_cs( WORD cs )   { return drbp_mode() == 3 && cs == 0x23 ? cs32_sel : cs; }
+static inline WORD cx_wow_seg_in_ss( WORD ss )   { return drbp_mode() == 3 && ss == 0x2b ? ds64_sel : ss; }
