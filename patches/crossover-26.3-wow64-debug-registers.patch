+    xbp_thread[t].call_ret = 0;
+    if (!ret || (DWORD)sp != xbp_thread[t].call_sp - 8) return;
+    /* the dword the callee will pop sits 4 bytes higher than where the
+     * 64-bit push left it */
+    if (NtWriteVirtualMemory( GetCurrentProcess(), (void *)(sp + 4), &ret, sizeof(ret), NULL )) return;
+    RSP_sig(ucontext) = sp + 4;
