--- a/dlls/ntdll/signal_x86_64.c
+++ b/dlls/ntdll/signal_x86_64.c
@@ -251,7 +251,27 @@
     nested_frame = 0;
     for (;;)
     {
-        status = virtual_unwind( UNW_FLAG_EHANDLER, &dispatch, &context );
+        BOOL unwind_faulted = FALSE;
+
+        /* A frame with bogus unwind data (obfuscated code, a corrupted stack) can send the
+         * unwinder outside the stack.  Windows reports a bad stack rather than faulting;
+         * faulting here dispatches another exception and recurses until the stack is gone. */
+        __TRY
+        {
+            status = virtual_unwind( UNW_FLAG_EHANDLER, &dispatch, &context );
+        }
+        __EXCEPT_ALL
+        {
+            unwind_faulted = TRUE;
+        }
+        __ENDTRY
+        if (unwind_faulted)
+        {
+            WARN( "unwind faulted at pc %I64x rsp %I64x, stopping handler search\n",
+                  context.Rip, context.Rsp );
+            rec->ExceptionFlags |= EXCEPTION_STACK_INVALID;
+            break;
+        }
         if (status != STATUS_SUCCESS) return status;
 
     unwind_done:
