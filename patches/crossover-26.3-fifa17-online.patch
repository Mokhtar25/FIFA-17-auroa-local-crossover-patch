+
+/* Keys that were never persisted -- a PFX imported into an ephemeral
+ * (CRYPT_VERIFYCONTEXT) container, which is what crypt32's PFXImportCertStore
+ * does for .NET's X509Certificate2 -- have no HKCU\Software\Wine\Crypto\RSA
+ * entry to read, so the registry lookup above finds nothing and every server
+ * credential built from such a certificate fails with SEC_E_INTERNAL_ERROR.
+ * The key is still reachable through the certificate's own provider, so export
+ * it from there instead; CryptExportKey produces exactly the PRIVATEKEYBLOB
+ * the gnutls backend expects. */
+static BYTE *get_key_blob_from_provider(const CERT_CONTEXT *ctx, DWORD *size)
+{
+    HCRYPTPROV prov = 0;
+    HCRYPTKEY key = 0;
+    DWORD spec = 0, len = 0;
+    BOOL free_prov = FALSE;
+    BYTE *buf = NULL;
+
+    if (!CryptAcquireCertificatePrivateKey(ctx, CRYPT_ACQUIRE_CACHE_FLAG, NULL, &prov, &spec, &free_prov))
+        return NULL;
+
+    if (!spec) spec = AT_KEYEXCHANGE;
+    if (!CryptGetUserKey(prov, spec, &key) &&
+        !CryptGetUserKey(prov, spec == AT_KEYEXCHANGE ? AT_SIGNATURE : AT_KEYEXCHANGE, &key))
+    {
+        WARN("no user key for spec %lu\n", spec);
+        if (free_prov) CryptReleaseContext(prov, 0);
+        return NULL;
+    }
+
+    /* calloc, not malloc: the caller is told about len + MAX_LEAD_BYTES bytes, to
+     * match what the registry path returns, but only len of them are written here.
+     * Leaving the slack uninitialised hands the gnutls backend whatever was on the
+     * heap. */
+    if (CryptExportKey(key, 0, PRIVATEKEYBLOB, 0, NULL, &len) && (buf = calloc(1, len + MAX_LEAD_BYTES)))
+    {
+        if (CryptExportKey(key, 0, PRIVATEKEYBLOB, 0, buf, &len)) *size = len + MAX_LEAD_BYTES;
+        else
+        {
+            WARN("failed to export private key\n");
+            free(buf);
+            buf = NULL;
+        }
+    }
+
+    CryptDestroyKey(key);
+    if (free_prov) CryptReleaseContext(prov, 0);
+    return buf;
+}
+
+static BYTE *get_key_blob(const CERT_CONTEXT *ctx, DWORD *size)
+{
+    BYTE *ret;
+
+    if ((ret = get_key_blob_from_registry(ctx, size))) return ret;
+    return get_key_blob_from_provider(ctx, size);
 }
 
