+
 
+/* Windows' UnhandledExceptionFilter decides whether a debugger is attached from the
+ * process debug port, not from PEB->BeingDebugged: patching that byte (a common
+ * anti-debug trick) must not stop the process's own top-level filter from running. */
+static BOOL debugger_attached( void )
+{
+    DWORD_PTR port = 0;
 
+    if (NtQueryInformationProcess( GetCurrentProcess(), ProcessDebugPort, &port, sizeof(port), NULL ))
+        return !!NtCurrentTeb()->Peb->BeingDebugged;
+    return !!port;
+}
+
