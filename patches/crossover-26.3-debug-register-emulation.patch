+            xbp[i] = xbp[--xbp_count];
+        }
+        else i++;
+    }
+    if ((t = xbp_thread_slot( tid, FALSE )) >= 0)
+    {
+        /* a step-over may be in flight: put the page back under protection */
+        if (xbp_thread[t].step_page &&
+            (p = xbp_find_page( xbp_thread[t].step_page )) >= 0)
+            xbp_set_prot( xbp_thread[t].step_page, xbp_page[p].stripped_prot );
+        xbp_thread[t].tid = 0;
+        xbp_thread[t].step_page = 0;
+        xbp_thread[t].skip_addr = 0;
+        xbp_thread[t].step_tf = 0;
+        xbp_thread[t].deliver_bmask = 0;
+    }
+    xbp_release();
+    drcache_forget( tid );
+}
