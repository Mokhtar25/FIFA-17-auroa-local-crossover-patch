+/* A thread is going away: drop its breakpoints, the page references they
+ * hold, any single-step state, and its cached debug registers, so the
+ * pages it armed do not stay protected and a reused TID inherits nothing.
+ * Runs on the exiting thread while it can still execute. */
+void drbp_thread_exit( ULONG_PTR tid )
+{
+    unsigned int i;
+    int t, p;
+
+    if (!tid || drbp_mode() != 3) return;
+    xbp_acquire();
+    for (i = 0; i < xbp_count; )
+    {
+        if (xbp[i].tid == tid)
+        {
