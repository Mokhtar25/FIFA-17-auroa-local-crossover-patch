+/* Read a thread's cached debug registers back.  TRUE when the thread has
+ * an entry. */
+static BOOL drcache_get( ULONG_PTR tid, DWORD64 *dr0, DWORD64 *dr1,
+                         DWORD64 *dr2, DWORD64 *dr3, DWORD64 *dr6, DWORD64 *dr7 )
+{
+    unsigned int i;
+    BOOL found = FALSE;
 
+    if (!tid) return FALSE;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++)
+    {
+        if (drcache[i].tid != tid) continue;
+        if (dr0) *dr0 = drcache[i].dr0;
+        if (dr1) *dr1 = drcache[i].dr1;
+        if (dr2) *dr2 = drcache[i].dr2;
+        if (dr3) *dr3 = drcache[i].dr3;
+        if (dr6) *dr6 = drcache[i].dr6;
+        if (dr7) *dr7 = drcache[i].dr7;
+        found = TRUE;
+        break;
+    }
+    drcache_release();
+    return found;
+}
+
+/* Replace a thread's cached status register alone, when it has an entry. */
+static void drcache_set_dr6( ULONG_PTR tid, DWORD64 dr6 )
+{
+    unsigned int i;
+
+    if (!tid) return;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++)
+    {
+        if (drcache[i].tid != tid) continue;
+        drcache[i].dr6 = dr6;
+        break;
+    }
+    drcache_release();
+}
+
+/* Drop a thread's cached debug registers; the thread is going away and a
+ * reused TID must inherit nothing. */
+static void drcache_forget( ULONG_PTR tid )
+{
+    unsigned int i;
+
+    if (!tid) return;
+    drcache_acquire();
+    for (i = 0; i < drcache_count; i++)
+    {
+        if (drcache[i].tid != tid) continue;
+        drcache[i] = drcache[--drcache_count];
+        break;
+    }
+    drcache_release();
+}
