+/***********************************************************************
+ *              capture_authorized
+ *
+ * Whether this process may record audio, asked once and cached.
+ *
+ * Every path that touches an input AudioUnit has to come through here first.
+ * Enabling input IO on an AUHAL, or merely querying it, makes the CoreAudio HAL
+ * do a synchronous round trip to coreaudiod; if the process has no capture
+ * authorization that call never returns, and it takes the caller's lock with it.
+ * The result is cached because the permission request itself is slow, and
+ * is_format_supported can be called many times during startup.
+ */
+static BOOL capture_authorized(void)
+{
+    static int cached = -1;
+    int status;
+
+    if (cached != -1) return cached;
+
+    status = CoreAudio_get_capture_authorization_status();
+    TRACE("Audio capture authorization status: %d\n", status);
+
+    if (status == NOT_DETERMINED)
+        status = CoreAudio_request_capture_authorization();
+
+    if (status == 0)
+        ERR_(winediag)("Microphone/audio capture permission was denied. "
+                       "This can be enabled under Security & Privacy in System Preferences.\n");
+
+    cached = (status != 0);
+    return cached;
+}
+
 static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid)
 {
     AudioComponentInstance unit;
